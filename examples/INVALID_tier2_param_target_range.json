{
  "schema_version": "1.0",
  "metadata": {
    "name": "INVALID tier 2 - parameter outside the range of its target field",
    "description": "Mỗi tham số hợp lệ với [min, max] của chính nó nhưng vượt miền schema của trường được gắn.",
    "category": "pedestrian",
    "tags": [
      "pedestrian",
      "urban",
      "rain",
      "vru"
    ]
  },
  "source": {
    "type": "manual"
  },
  "map": {
    "name": "Town05"
  },
  "route": {
    "start": {
      "spawn_point_index": 12
    },
    "goal": {
      "spawn_point_index": 87
    },
    "speed_limit_kmh": 40,
    "goal_tolerance_m": 5
  },
  "weather": {
    "preset": "HardRainNoon",
    "fog_density": 10,
    "wetness": 80
  },
  "ego_vehicle": {
    "blueprint": "vehicle.tesla.model3",
    "role_name": "hero"
  },
  "traffic": {
    "npc_vehicles": {
      "count": {
        "$param": "npc_count"
      }
    },
    "pedestrians": {
      "count": 5,
      "crossing_probability": 0.1
    }
  },
  "actors": [
    {
      "id": "ped_01",
      "type": "pedestrian",
      "blueprint": "walker.pedestrian.0001",
      "spawn": {
        "x": 20.5,
        "y": -60.2,
        "z": 1.0,
        "yaw": 90
      },
      "behavior": "scripted"
    },
    {
      "id": "veh_01",
      "type": "vehicle",
      "blueprint": "vehicle.tesla.model3",
      "spawn": {
        "spawn_point_index": 30
      },
      "behavior": "scripted",
      "initial_speed_kmh": {
        "$param": "lead_speed_kmh"
      }
    }
  ],
  "events": [
    {
      "id": "ev_ped_cross",
      "type": "pedestrian_crossing",
      "description": "ped_01 băng qua đường khi ego tới gần",
      "trigger": {
        "type": "ego_distance_to_actor",
        "actor_ref": "ped_01",
        "distance_m": {
          "$param": "trigger_distance_m"
        }
      },
      "actor_ref": "ped_01",
      "params": {
        "speed_ms": {
          "$param": "pedestrian_speed_ms"
        },
        "direction": "left_to_right"
      }
    },
    {
      "id": "ev_light",
      "type": "traffic_light_override",
      "trigger": {
        "type": "simulation_time",
        "time_s": 20
      },
      "params": {
        "state": "red",
        "duration_s": {
          "$param": "red_duration_s"
        }
      }
    },
    {
      "id": "ev_brake",
      "type": "lead_vehicle_brake",
      "actor_ref": "veh_01",
      "trigger": {
        "type": "ego_distance_to_actor",
        "actor_ref": "veh_01",
        "distance_m": {
          "$param": "brake_distance_m"
        }
      },
      "params": {
        "deceleration_ms2": 6
      }
    }
  ],
  "parameters": {
    "trigger_distance_m": {
      "type": "number",
      "value": 10,
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "m",
      "description": "Khoảng cách ego-pedestrian lúc pedestrian bắt đầu băng qua"
    },
    "pedestrian_speed_ms": {
      "type": "number",
      "value": 1.4,
      "min": 0.5,
      "max": 8,
      "step": 0.5,
      "unit": "m/s",
      "description": "value hợp lệ nhưng max 8 > max 6 của speed_ms"
    },
    "npc_count": {
      "type": "number",
      "value": 20,
      "min": 0,
      "max": 60,
      "description": "count là integer nên tham số phải type integer"
    },
    "red_duration_s": {
      "type": "number",
      "value": 200,
      "min": 10,
      "max": 500,
      "unit": "s",
      "description": "value 200 > max 120 của duration_s"
    },
    "lead_speed_kmh": {
      "type": "number",
      "value": 60,
      "min": 20,
      "max": 100,
      "unit": "km/h",
      "description": "hợp lệ: nằm trong 0-130 của initial_speed_kmh"
    },
    "brake_distance_m": {
      "type": "number",
      "value": 0.2,
      "min": 0.1,
      "max": 40,
      "unit": "m",
      "description": "value 0.2 < min 0.5 của trigger.distance_m"
    }
  },
  "execution": {
    "seed": 42,
    "timeout_s": 120
  }
}
